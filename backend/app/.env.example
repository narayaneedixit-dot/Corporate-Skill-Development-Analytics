# Supabase PostgreSQL connection string. Set this as a secret environment variable on Render.
# Prefer Supabase Session Pooler (port 5432 for session pooler; use the exact URI from Supabase).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Render injects PORT automatically. Do not hardcode it in production.
HOST=0.0.0.0
PORT=8001
DEBUG=false

# JSON array of allowed frontend origins. Replace the example with the deployed Render Static Site URL.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
